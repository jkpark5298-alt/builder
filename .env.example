# Optional: OpenAI-compatible API for real summary / fact-check
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Kakao JavaScript Key (for KakaoTalk share)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Vercel Blob — 이미지 1차 저장소. 연결되면 Blob에 먼저 올리고, 이상 시 Neon으로 폴백합니다.
# Vercel Dashboard → Storage → Blob 스토어 생성 후 프로젝트에 연결하면 토큰이 자동 주입됩니다.
BLOB_READ_WRITE_TOKEN=

# 강제로 Neon만 쓰려면 1 (비권장 — DB 용량을 채웁니다)
# NEON_MEDIA_FORCE=1

# Optional: Supadata transcript API (bypasses YouTube IP blocks on Vercel)
# https://supadata.ai — set in Vercel project env
SUPADATA_API_KEY=
